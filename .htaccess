<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^(?:\.env(?:\..*)?|artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.(?:js|ts)|tsconfig\.json)$">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Defense in depth when the project root is accidentally used as DocRoot.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule ^(?:app|bootstrap|config|database|node_modules|resources|routes|tests|vendor)(?:/|$) - [F,L,NC]
    RewriteRule ^public(?:/|$) - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
